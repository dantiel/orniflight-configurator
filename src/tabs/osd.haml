.tab-osd.toolbar_fixed_bottom
  .content_wrapper
    %h1.tab_title
      %span{i18n: "osdSetupTitle"}
    .cf_doc_version_bt
      %a#button-documentation{href: "", target: "_blank"}
    .unsupported.hide
      %p.note{i18n: "osdSetupUnsupportedNote1"}
      %p.note{i18n: "osdSetupUnsupportedNote2"}
    .supported.hide
      %div{style: "margin-bottom: 10px;"}
        %p.note{i18n: "osdSetupPreviewHelp"}
      .cf_column.third_left.elements.requires-osd-feature
        .spacer_right
          .gui_box.grey
            .gui_box_titlebar{style: "margin-bottom: 0px;"}
              .spacer_box_title
                %span.osd-profiles-header.cf_tip{i18n_title: "osdSetupProfilesTitle"}
                  / Generated profiles header here
                %span{i18n: "osdSetupElementsTitle"}
            .spacer_box
              #element-fields.switchable-fields
      .cf_column.twothird
        .gui_box.grey.preview.requires-osd-feature
          .gui_box_titlebar.image
            .spacer_box_title
              %span.cf_tip{i18n_title: "osdSetupPreviewForTitle"}
                %label#osdprofile-selector-label{i18n: "osdSetupPreviewSelectProfileTitle"}
                  %select.osdprofile-selector
                    / Populated at runtime
                  %select.osdfont-selector
                    / Populated at runtime
          .display-layout
            .col.right
              .preview
          .gui_box_bottombar
            .spacer_box_title
              %span{i18n: "osdSetupPreviewTitle"}
        .cf_column.third_right{style: "width: calc(100% - 377px);"}
          .gui_box.osdprofile-selected-container.grey.requires-max7456
            .gui_box_titlebar.cf_tip
              .spacer_box_title{i18n: "osdSetupSelectedProfileTitle"}
              .spacer_box
                %label{i18n: "osdSetupSelectedProfileLabel"}
                  %select.osdprofile-active
                    / Populated at runtime
            .gui_box.videomode-container.grey.requires-max7456
              .gui_box_titlebar.cf_tip
                .spacer_box_title{i18n: "osdSetupVideoFormatTitle"}
                .spacer_box
                  .video-types
              .gui_box.grey.units-container.requires-osd-feature{style: "display:none;"}
                .gui_box_titlebar.cf_tip
                  .spacer_box_title{i18n: "osdSetupUnitsTitle"}
                  .spacer_box
                    .units
                .gui_box.grey.timers-container.requires-osd-feature{style: "display:none;"}
                  .gui_box_titlebar.cf_tip{style: "margin-bottom: 0px;"}
                    .spacer_box_title{i18n: "osdSetupTimersTitle"}
                    .spacer_box
                      #timer-fields.switchable-fields
                  .gui_box.grey.alarms-container.requires-osd-feature{style: "display:none;"}
                    .gui_box_titlebar.cf_tip
                      .spacer_box_title{i18n: "osdSetupAlarmsTitle"}
                      .spacer_box
                        .alarms
                    .gui_box.grey.warnings-container.requires-osd-feature{style: "display:none;"}
                      .gui_box_titlebar.cf_tip{style: "margin-bottom: 0px;"}
                        .spacer_box_title
                          .spacer_box_title{i18n: "osdSetupWarningsTitle"}
                        .spacer_box
                          #warnings-fields.switchable-fields
                      .gui_box.grey.stats-container.requires-osd-feature{style: "display:none;"}
                        .gui_box_titlebar{style: "margin-bottom: 0px;"}
                          .spacer_box_title{i18n: "osdSetupStatsTitle"}
                          .spacer_box
                            #post-flight-stat-fields.switchable-fields
                        .gui_box.grey{style: "display:none;"}
                          .gui_box_titlebar
                            .spacer_box_title{i18n: "osdSetupVtxTitle"}
                            .spacer_box
                              .vtx-settings
                          .gui_box.grey{style: "display:none;"}
                            .gui_box_titlebar
                              .spacer_box_title{i18n: "osdSetupCraftNameTitle"}
                              .spacer_box
                                .callsign
                        / Font Manager dialog
                        #fontmanagercontent{style: "display:none; width:720px;"}
                          .font-picker{style: "margin-bottom: 10px;"}
                            %h1.tab_title{i18n: "osdSetupFontPresets"}
                              / Font preview and list
                              %label.font-manager-version-info
                              .content_wrapper.font-preview
                              .fontpresets_wrapper
                                %label#font-selector-label{i18n: "osdSetupFontPresetsSelector"}
                                %select.fontpresets
                                  %option{disabled: "", i18n: "osdSetupFontPresetsSelectorCustomOption", value: "-1"}
                                    / Other values populated at runtime
                                %span#font-selector-span{i18n: "osdSetupFontPresetsSelectorOr"} Or
                              / Boot logo setup
                              %h1.tab_title{i18n: "osdSetupCustomLogoTitle"}
                                #font-logo-preview-container.content_wrapper
                                  #font-logo-preview
                                    / this will be resized at runtime
                                #font-logo-info
                                  %h3{i18n: "osdSetupCustomLogoInfoTitle"}
                                  %ul
                                    %li#font-logo-info-size{i18n: "osdSetupCustomLogoInfoImageSize"}
                                    %li#font-logo-info-colors{i18n: "osdSetupCustomLogoInfoColorMap"}
                                  %p#font-logo-info-upload-hint{i18n: "osdSetupCustomLogoInfoUploadHint"}
                                .clear-both
                                / Replace logo button
                                .default_btn{style: "width:100%; float:left;"}
                                  %a.replace_logo{i18n: "osdSetupCustomLogoOpenImageButton"}
                                / Upload progress bar
                                .info
                                  %a{name: "progressbar"}
                                  %progress.progress{max: "100", min: "0", value: "0"}
                                  .progressLabel{style: "margin-top: -21px; width: 95%; text-align: center; position: absolute;"}
                          / Upload button
                          .default_btn.green{style: "width:100%; float:left;
                        "}
                            %a.flash_font.active{i18n: "osdSetupUploadFont"}
                        .content_toolbar.supported.hide{style: "left:0;"}
                          .btn.save
                            %a.active.save{href: "#", i18n: "osdSetupSave"}
                          .btn.requires-max7456
                            %a#fontmanager.fonts{href: "#", i18n: "osdSetupFontManager"}
