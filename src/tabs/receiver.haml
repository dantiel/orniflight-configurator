.tab-receiver.toolbar_fixed_bottom
  .content_wrapper
    .tab_title{i18n: "tabReceiver"}
    .cf_doc_version_bt
      %a#button-documentation{href: "https://github.com/dantiel/orniflight/releases", rel: "noopener noreferrer", target: "_blank"}
    .note
      %p{i18n: "receiverHelp"}
    .bars
    .fc_column
      .rssi_channel_wrapper.grey
        .head{i18n: "receiverRssiChannel"}
        %select{name: "rssi_channel"}
          / list generated here
      .rcmap_wrapper.grey
        .head
          %span{i18n: "receiverChannelMap", i18n_title: "receiverChannelMapTitle"}
        .hybrid_element
          %input{name: "rcmap", spellcheck: "false", type: "text"}
          %select.hybrid_helper{name: "rcmap_helper"}
            %option{i18n: "receiverChannelDefaultOption", value: "AETR1234"}
            %option{value: "AETR1234"} FrSky / Futaba / Hitec
            %option{value: "TAER1234"} Spektrum / Graupner / JR
      .gui_box.tunings.grey
        %table.sticks
          %tr
            %th{i18n: "receiverStickMin"}
            %th{i18n: "receiverStickCenter"}
            %th{i18n: "receiverStickMax"}
          %tr
            %td
              .input-helpicon-flex
                %input{max: "1200", min: "1000", name: "stick_min", type: "number"}
                .helpicon.cf_tip{i18n_title: "receiverHelpStickMin"}
            %td
              .input-helpicon-flex
                %input{max: "1599", min: "1401", name: "stick_center", type: "number"}
                .helpicon.cf_tip{i18n_title: "receiverHelpStickCenter"}
            %td
              .input-helpicon-flex
                %input{max: "2000", min: "1800", name: "stick_max", type: "number"}
                .helpicon.cf_tip{i18n_title: "receiverHelpStickMax"}
      .gui_box.tunings.grey
        %table.deadband
          %tr
            %th{i18n: "receiverDeadband"}
            %th{i18n: "receiverYawDeadband"}
            %th{i18n: "recevier3dDeadbandThrottle"}
          %tr
            %td
              .input-helpicon-flex
                %input{max: "32", min: "0", name: "deadband", step: "1", type: "number"}
                .helpicon.cf_tip{i18n_title: "receiverHelpDeadband"}
            %td
              .input-helpicon-flex
                %input{max: "100", min: "0", name: "yaw_deadband", step: "1", type: "number"}
                .helpicon.cf_tip{i18n_title: "receiverHelpYawDeadband"}
            %td
              .input-helpicon-flex
                %input{max: "100", min: "0", name: "3ddeadbandthrottle", step: "1", type: "number"}
                .helpicon.cf_tip{i18n_title: "receiverHelp3dDeadbandThrottle"}
      .gui_box.grey.tunings.topspacer.rcSmoothing
        %table.rcSmoothing-table
          %tr
            %th{colspan: "3", i18n: "receiverRcSmoothing"}
          %tr.rc-smoothing-type
            %td
              %select{name: "rcSmoothing-select"}
                %option{i18n: "receiverRcSmoothingInterpolation", value: "0"}
                %option{i18n: "receiverRcSmoothingFilter", value: "1"}
            %td{colspan: "2"}
              %div
                %label
                  %span{i18n: "receiverRcSmoothingType"}
          %tr.rc-smoothing-channels
            %td
              %select{name: "rcSmoothingChannels-select"}
                %option{value: "0"} RP
                %option{value: "1"} RPY
                %option{value: "2"} RPYT
                %option{value: "3"} T
                %option{value: "4"} RPT
            %td{colspan: "2"}
              %div
                %label
                  %span{i18n: "receiverRcSmoothingChannel"}
          %tr.rcSmoothing-input-manual
            %td
              %select{name: "rcSmoothing-input-manual-select"}
                %option{i18n: "receiverRcSmoothingAuto", value: "0"}
                %option{i18n: "receiverRcSmoothingManual", value: "1"}
            %td
              %div
                %label
                  %span{i18n: "receiverRcInputTypeSelect"}
            %td
              .helpicon.cf_tip{i18n_title: "receiverRcSmoothingInputManual"}
          %tr.rcSmoothing-input-manual
            %td.rcSmoothing-input-cutoff
              %input{max: "255", min: "1", name: "rcSmoothingInputHz-number", step: "1", type: "number"}
            %td.rcSmoothing-input-cutoff{colspan: "2"}
              %div
                %label
                  %span{i18n: "receiverRcSmoothingInputHz"}
                .helpicon.cf_tip{i18n_title: "rcSmoothingInputCutoffHelp"}
          %tr.rcSmoothing-input-type
            %td
              %select{name: "rcSmoothingInputType-select"}
                %option{value: "0"} PT1
                %option{value: "1"} BIQUAD
            %td
              %div
                %label
                  %span{i18n: "receiverRcInputType"}
            %td
              .helpicon.cf_tip{i18n_title: "rcSmoothingInputTypeHelp"}
          %tr.rcSmoothing-derivative-manual
            %td
              %select{name: "rcSmoothing-input-derivative-select"}
                %option{i18n: "receiverRcSmoothingAuto", value: "0"}
                %option{i18n: "receiverRcSmoothingManual", value: "1"}
            %td
              %div
                %label
                  %span{i18n: "receiverRcDerivativeTypeSelect"}
            %td
              .helpicon.cf_tip{i18n_title: "receiverRcSmoothingDerivativeManual"}
          %tr.rcSmoothing-derivative-manual
            %td.rcSmoothing-derivative-cutoff
              %input{max: "255", min: "1", name: "rcSmoothingDerivativeCutoff-number", step: "1", type: "number"}
            %td.rcSmoothing-derivative-cutoff{colspan: "2"}
              %div
                %label
                  %span{i18n: "receiverRcSmoothingDerivativeCutoff"}
                .helpicon.cf_tip{i18n_title: "rcSmoothingDerivativeCutoffHelp"}
          %tr.rcSmoothing-input-type
            %td
              %select{name: "rcSmoothingDerivativeType-select"}
                %option{i18n: "receiverRcSmoothingDerivativeTypeOff", value: "0"}
                %option{value: "1"} PT1
                %option{value: "2"} BIQUAD
            %td
              %div
                %label
                  %span{i18n: "receiverRcDerivativeType"}
            %td
              .helpicon.cf_tip{i18n_title: "rcSmoothingDerivativeTypeHelp"}
          %tr.rcSmoothing-auto-smoothness
            %td
              %input{max: "50", min: "0", name: "rcSmoothingAutoSmoothness-number", step: "1", type: "number"}
            %td
              %div
                %label
                  %span{i18n: "receiverRcSmoothingAutoSmoothness"}
            %td
              .helpicon.cf_tip{i18n_title: "receiverRcSmoothingAutoSmoothnessHelp"}
          %tr.rcInterpolation
            %td
              %select{name: "rcInterpolation-select"}
                %option{i18n: "receiverRcInterpolationOff", value: "0"}
                %option{i18n: "receiverRcInterpolationDefault", value: "1"}
                %option{i18n: "receiverRcInterpolationAuto", value: "2"}
                %option{i18n: "receiverRcInterpolationManual", value: "3"}
            %td
              .rcInterpolation-label
                %label
                  %span{i18n: "receiverRcInterpolation"}
                .helpicon.cf_tip{i18n_title: "receiverRcInterpolationHelp"}
          %tr.rcInterpolation
            %td.rc-interpolation-manual{colspan: "1"}
              %input{max: "50", min: "1", name: "rcInterpolationInterval-number", step: "1", type: "number"}
            %td.rc-interpolation-manual{colspan: "2"}
              %div
                %label
                  %span{i18n: "receiverRcInterpolationInterval"}
                .helpicon.cf_tip{i18n_title: "receiverRcInterpolationIntervalHelp"}
      .gui_box.grey.tunings.topspacer
        %table.pid_titlebar
          %thead
            %tr
              %th{i18n: "receiverModelPreview"}
          %tbody
            %tr
              %td.model_preview_cell
                .model_preview
                  %canvas#canvas
    .clear-both
    .gui_box.grey
      .spacer
        %select{i18n_title: "receiverRefreshRateTitle", name: "rx_refresh_rate"}
          %option{value: "10"} 10 ms
          %option{value: "20"} 20 ms
          %option{value: "30"} 30 ms
          %option{value: "40"} 40 ms
          %option{selected: "selected", value: "50"} 50 ms
          %option{value: "100"} 100 ms
          %option{value: "250"} 250 ms
          %option{value: "500"} 500 ms
          %option{value: "1000"} 1000 ms
        .clear-both
        %svg#RX_plot
          %g.grid.x{transform: "translate(40, 180)"}
          %g.grid.y{transform: "translate(40, 10)"}
          %g.data{transform: "translate(41, 1)"}
          %g.axis.x{transform: "translate(40, 180)"}
          %g.axis.y{transform: "translate(40, 10)"}
  .content_toolbar
    .btn.sticks_btn
      %a.sticks{href: "#", i18n: "receiverButtonSticks"}
    .btn.refresh_btn
      %a.refresh{href: "#", i18n: "receiverButtonRefresh"}
    .btn.update_btn
      %a.update{href: "#", i18n: "receiverButtonSave"}
