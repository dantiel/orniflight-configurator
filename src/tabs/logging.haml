.tab-logging.toolbar_fixed_bottom
  .content_wrapper
    .tab_title{i18n: "tabLogging"}
    .cf_doc_version_bt
      %a#button-documentation{href: "https://github.com/dantiel/orniflight/releases", rel: "noopener noreferrer", target: "_blank"}
    .note
      %p{i18n: "loggingNote"}
    .properties
      %dl
        %dt
          %label
            %input{name: "MSP_RAW_IMU", type: "checkbox"}
            MSP_RAW_IMU
        %dd 9 columns (accel[x, y, z], gyro[x, y, z], mag[x, y, z])
        %dt
          %label
            %input{name: "MSP_ATTITUDE", type: "checkbox"}
            MSP_ATTITUDE
        %dd 3 columns (x, y, z)
        %dt
          %label
            %input{name: "MSP_ALTITUDE", type: "checkbox"}
            MSP_ALTITUDE
        %dd one column
        %dt
          %label
            %input{name: "MSP_RAW_GPS", type: "checkbox"}
            MSP_RAW_GPS
        %dd 7 columns
        %dt
          %label
            %input{name: "MSP_ANALOG", type: "checkbox"}
            MSP_ANALOG
        %dd 4 columns
        %dt
          %label
            %input{name: "MSP_RC", type: "checkbox"}
            MSP_RC
        %dd 8 columns by default
        %dt
          %label
            %input{name: "MSP_MOTOR", type: "checkbox"}
            MSP_MOTOR
        %dd 8 columns by default
        %dt
          %label
            %input{name: "MSP_DEBUG", type: "checkbox"}
            MSP_DEBUG
        %dd 4 columns
    %select.speed{name: "speed"}
      %option{value: "10"} 10 ms
      %option{value: "20"} 20 ms
      %option{value: "30"} 30 ms
      %option{value: "40"} 40 ms
      %option{value: "50"} 50 ms
      %option{selected: "selected", value: "100"} 100 ms
      %option{value: "250"} 250 ms
      %option{value: "500"} 500 ms
      %option{value: "1000"} 1000 ms
      %option{value: "2000"} 2000 ms
      %option{value: "5000"} 5000 ms
    .info
      %dl
        %dt{i18n: "loggingSamplesSaved"}
        %dd.samples 0
        %dt{i18n: "loggingLogSize"}
        %dd.size 0 Bytes
  .content_toolbar
    .btn.file_btn
      %a.log_file{href: "#", i18n: "loggingButtonLogFile"}
    .btn.back_btn
      %a.back{href: "#", i18n: "loggingBack"}
    .btn.logging_btn
      %a.logging{href: "#", i18n: "loggingStart"}
