    .cf_column.half
      .gui_box.grey.gps_map
        .gui_box_titlebar{style: "margin-bottom: 0px;"}
          .spacer_box_title{i18n: "gpsMapHead"}
        #connect{i18n: "gpsMapMessage1"}
          .default_btn{style: "width:50px; margin-left:auto; margin-right:auto; float:none;"}
            %a#check retry
        #waiting
          .info{i18n: "gpsMapMessage2"}
        #loadmap
          %webview#map.map{partition: "persist:map", src: "tabs/map.html"}
          .controls
            %a#zoom_in{href: "#"} +
            %a#zoom_out{href: "#"} –
