.tab-gps
  .content_wrapper
    .tab_title{i18n: "tabGPS"} GPS
    .cf_doc_version_bt
      %a#button-documentation{href: "https://github.com/dantiel/orniflight/releases", rel: "noopener noreferrer", target: "_blank"}
    .cf_column.fourth
      .spacer_right
        .gui_box.grey
          .gui_box_titlebar
            .spacer_box_title{i18n: "gpsHead"}
          .spacer_box.GPS_info
            %table.cf_table
              %tr
                %td{i18n: "gps3dFix", style: "width: 85px"}
                %td.fix{i18n: "gpsFixFalse"}
              %tr
                %td{i18n: "gpsAltitude"}
                %td.alt 0 m
              %tr
                %td{i18n: "gpsLat"}
                %td.lat
                  %a{href: "#", target: "_blank"} 0.0000 deg
              %tr
                %td{i18n: "gpsLon"}
                %td.lon
                  %a{href: "#", target: "_blank"} 0.0000 deg
              %tr
                %td{i18n: "gpsSpeed"}
                %td.speed 0 cm/s
              %tr
                %td{i18n: "gpsSats"}
                %td.sats 0
              %tr.noboarder
                %td{i18n: "gpsDistToHome"}
                %td.distToHome
    .cf_column.fourth
      .spacer_right
        .gui_box.grey{style: "margin-bottom: -5px;"}
          .gui_box_titlebar
            .spacer_box_title{i18n: "gpsSignalStrHead"}
          .spacer_box.GPS_signal_strength
            %table.cf_table
              %tr.titles
                %td{i18n: "gpsSignalSatId", style: "width: 20%;"}
                %td{i18n: "gpsSignalQty", style: "width: 15%;"}
                %td{i18n: "gpsSignalStr", style: "width: 65%;"}
              %tr
                %td 0
                %td 0
                %td
                  %progress{max: "99", value: "0"}
              %tr
                %td 0
                %td 0
                %td
                  %progress{max: "99", value: "0"}
              %tr
                %td 0
