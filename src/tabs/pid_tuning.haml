                        %input#yawLowpassEnabled.toggle{type: "checkbox"}
                      %span.inputValue
                        %input{max: "500", min: "1", name: "yawLowpassFrequency", step: "1", type: "number"}
                  %td
                    %div
                      %label
                        %span{i18n: "pidTuningYawLowpassFrequency"}
