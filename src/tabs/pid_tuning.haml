.tab-pid_tuning.toolbar_fixed_bottom
  .content_wrapper
    .tab_title{i18n: "tabPidTuning"}
    .cf_doc_version_bt
      %a#button-documentation{href: "https://github.com/dantiel/orniflight/releases", rel: "noopener noreferrer", target: "_blank"}
    .cf_column
      .profile.single-field
        .helpicon.cf_tip.topspacer{i18n_title: "pidTuningProfileTip"}
        .head{i18n: "pidTuningProfile"}
        .bottomarea
          %select{name: "profile"}
            / list generated here
      .rate_profile.single-field
        .helpicon.cf_tip.topspacer{i18n_title: "pidTuningRateProfileTip"}
        .head{i18n: "pidTuningRateProfile"}
        .bottomarea
          %select{name: "rate_profile"}
            / list generated here
      .controller.single-field
        .helpicon.cf_tip.topspacer{i18n_title: "pidTuningPidControllerTip"}
        .head{i18n: "pidTuningControllerHead"}
        .bottomarea
          %select{name: "controller"}
            / list generated here
      .cf_column.right
        .default_btn.show.showAllPids
          %a#showAllPids{href: "#", i18n: "pidTuningShowAllPids"}
        .default_btn.resetbt
          %a#resetProfile{href: "#", i18n: "pidTuningResetProfile"}
        .default_btn.copyrateprofilebtn
          %a#copyRateProfile{href: "#", i18n: "pidTuningCopyRateProfile"}
        .default_btn.copyprofilebtn
          %a#copyProfile{href: "#", i18n: "pidTuningCopyProfile"}
    .tab_container
      %table
        %tr
          %td.pid.active
            %a{href: "#", i18n: "pidTuningSubTabPid"}
          %td.rates
            %a{href: "#", i18n: "pidTuningSubTabRates"}
          %td.filter
            %a{href: "#", i18n: "pidTuningSubTabFilter"}
    .tabboarder
    .tabarea
      %form#pid-tuning{name: "pid-tuning"}
        .subtab-pid
          .clear-both
          .cf_column
            .note.dMinDisabledNote
              %p{i18n: "pidTuningDMinDisabledNote"}
            .note.slidersWarning
              %p{i18n: "pidTuningSliderWarning"}
            .gui_box.grey
              %table#pid_main.pid_tuning
                %tr.pid_titlebar
                  %th.name
                  %th.proportional
                    .name-helpicon-flex
                      %div{i18n: "pidTuningProportional"}
                      .helpicon.cf_tip{i18n_title: "pidTuningProportionalHelp"}
                  %th.integral
                    .name-helpicon-flex
                      %div{i18n: "pidTuningIntegral"}
                      .helpicon.cf_tip{i18n_title: "pidTuningIntegralHelp"}
                  %th.derivative
                    .name-helpicon-flex
                      %div{i18n: "pidTuningDerivative"}
                      .helpicon.cf_tip{i18n_title: "pidTuningDerivativeHelp"}
                  %th.dmin
                    .name-helpicon-flex
                      %div{i18n: "pidTuningDMin"}
                      .helpicon.cf_tip{i18n_title: "pidTuningDMinHelp"}
                  %th.feedforward
                    .name-helpicon-flex
                      %div{i18n: "pidTuningFeedforward"}
                      .helpicon.cf_tip{i18n_title: "pidTuningFeedforwardHelp"}
                %tr.pid_titlebar2
                  %th{colspan: "6"}
                    .pid_mode
                      %div{i18n: "pidTuningBasic", style: "float:left;"}
                %tr.ROLL
                  / 0
                  %td.pid_roll
                  %td.pid_data
                    %input{max: "200", min: "0", name: "p", step: "1", type: "number"}
                  %td.pid_data
                    %input{max: "200", min: "0", name: "i", step: "1", type: "number"}
                  %td.pid_data
                    %input{max: "200", min: "0", name: "d", step: "1", type: "number"}
                  %td.pid_data
                    %input{max: "100", min: "0", name: "dMinRoll", step: "1", type: "number"}
                  %td.pid_data
                    %input{max: "2000", min: "0", name: "f", step: "1", type: "number"}
                %tr.PITCH
                  / 1
                  %td.pid_pitch
                  %td.pid_data
                    %input{max: "200", min: "0", name: "p", step: "1", type: "number"}
                  %td.pid_data
                    %input{max: "200", min: "0", name: "i", step: "1", type: "number"}
                  %td.pid_data
                    %input{max: "200", min: "0", name: "d", step: "1", type: "number"}
                  %td.pid_data
                    %input{max: "100", min: "0", name: "dMinPitch", step: "1", type: "number"}
                  %td.pid_data
                    %input{max: "2000", min: "0", name: "f", step: "1", type: "number"}
                %tr.YAW
                  / 2
                  %td.pid_yaw
                  %td.pid_data
                    %input{max: "200", min: "0", name: "p", step: "1", type: "number"}
                  %td.pid_data
                    %input{max: "200", min: "0", name: "i", step: "1", type: "number"}
                  %td.pid_data
                    %input{max: "200", min: "0", name: "d", step: "1", type: "number"}
                  %td.pid_data
                    %input{max: "100", min: "0", name: "dMinYaw", step: "1", type: "number"}
                  %td.pid_data
                    %input{max: "2000", min: "0", name: "f", step: "1", type: "number"}
                %tr.YAW_JUMP_PREVENTION
                  %td{colspan: "3"}
                    %div
                      %div{i18n: "pidTuningYawJumpPrevention", style: "float:left;"}
                      .helpicon.cf_tip{i18n_title: "pidTuningYawJumpPreventionHelp"}
                  %td.pid_data
                    %input{max: "255", min: "0", name: "d", step: "1", type: "number"}
                  %td{colspan: "4"}
            .gui_box.topspacer.slidersDisabled
              %table.note-button
                %td{i18n: "pidTuningSlidersDisabled"}
                %td
                  %a.buttonPidTuningSliders.regular-button{href: "#", i18n: "pidTuningSliderEnableButton"}
            .gui_box.topspacer.nonExpertModeSlidersNote
              %p{i18n: "pidTuningSlidersNonExpertMode"}
            / TUNING SLIDERS
            .gui_box.grey.topspacer.tuningPIDSliders
              %table.pid_titlebar
                %tr
                  %th
                  %th
                  %th{i18n: "pidTuningSliderLow"}
                  %th{i18n: "pidTuningSliderDefault"}
                  %th{i18n: "pidTuningSliderHigh"}
                  %th
                    .helpicon.cf_tip{i18n_title: "pidTuningPidSlidersHelp"}
              %table.sliderLabels
                %tr
                  %td
                    %span{i18n: "pidTuningMasterSlider"}
                  %td
                    %output{name: "tuningMasterSlider-number", type: "number"}
                  %td{colspan: "3"}
                    %input#tuningMasterSlider.tuningSlider{max: "1.5", min: "0.5", step: "0.05", type: "range"}
                  %td
                    .helpicon.cf_tip{i18n_title: "pidTuningMasterSliderHelp"}
                %tr
                  %td
                    %span{i18n: "pidTuningPDRatioSlider"}
                  %td
                    %output{name: "tuningPDRatioSlider-number", type: "number"}
                  %td{colspan: "3"}
                    %input#tuningPDRatioSlider.tuningSlider{max: "1.5", min: "0.5", step: "0.05", type: "range"}
                  %td
                    .helpicon.cf_tip{i18n_title: "pidTuningPDRatioSliderHelp"}
                %tr
                  %td
                    %span{i18n: "pidTuningPDGainSlider"}
                  %td
                    %output{name: "tuningPDGainSlider-number", type: "number"}
                  %td{colspan: "3"}
                    %input#tuningPDGainSlider.tuningSlider{max: "1.5", min: "0.5", step: "0.05", type: "range"}
                  %td
                    .helpicon.cf_tip{i18n_title: "pidTuningPDGainSliderHelp"}
                %tr
                  %td
                    %span{i18n: "pidTuningResponseSlider"}
                  %td
                    %output{name: "tuningResponseSlider-number", type: "number"}
                  %td{colspan: "3"}
                    %input#tuningResponseSlider.tuningSlider{max: "1.5", min: "0.5", step: "0.05", type: "range"}
                  %td
                    .helpicon.cf_tip{i18n_title: "pidTuningResponseSliderHelp"}
            / BARO, MAG, GPS
            #pid_baro_mag_gps.pid_optional.needed_by_ALT.needed_by_VEL.needed_by_MAG.needed_by_Pos.needed_by_PosR.needed_by_NavR.gui_box.grey.topspacer.pid_tuning
              %table.pid_titlebar.needed_by_ALT.needed_by_VEL.needed_by_MAG
                %tr.needed_by_ALT.needed_by_VEL.needed_by_MAG
                  %th.name
                  %th.proportional{i18n: "pidTuningProportional"}
                  %th.integral{i18n: "pidTuningIntegral"}
                  %th.derivative{i18n: "pidTuningDerivative"}
              %table#pid_baro.pid_tuning.needed_by_ALT.needed_by_VEL
                %tr.needed_by_ALT.needed_by_VEL
                  %th{colspan: "4"}
                    .pid_mode{i18n: "pidTuningAltitude"}
                %tr.ALT
                  / 3
                  %td
                  %td
                    %input{max: "255", min: "0", name: "p", step: "1", type: "number"}
                  %td
                    %input{max: "255", min: "0", name: "i", step: "1", type: "number"}
                  %td
                    %input{max: "255", min: "0", name: "d", step: "1", type: "number"}
                %tr.VEL
                  / 9
                  %td
                  %td
                    %input{max: "255", min: "0", name: "p", step: "1", type: "number"}
                  %td
                    %input{max: "255", min: "0", name: "i", step: "1", type: "number"}
                  %td
                    %input{max: "255", min: "0", name: "d", step: "1", type: "number"}
              %table#pid_mag.pid_tuning.needed_by_MAG
                %tr.needed_by_MAG
                  %th{colspan: "4"}
                    .pid_mode{i18n: "pidTuningMag"}
                %tr.MAG
                  / 8
                  %td
                  %td
                    %input{max: "255", min: "0", name: "p", step: "1", type: "number"}
                  %td
                  %td
              %table#pid_gps.pid_tuning.needed_by_Pos.needed_by_PosR.needed_by_NavR
                %tr.needed_by_Pos.needed_by_PosR.needed_by_NavR
                  %th{colspan: "4"}
                    .pid_mode{i18n: "pidTuningGps"}
                %tr.Pos
                  / 4
                  %td
                  %td
                    %input{max: "255", min: "0", name: "p", step: "1", type: "number"}
                  / <td><input type="number" name="i" step="1" min="0" max="255" /></td>
                  %td
                  %td
                %tr.PosR
                  / 5
                  %td
                  %td
                    %input{max: "255", min: "0", name: "p", step: "1", type: "number"}
                  %td
                    %input{max: "255", min: "0", name: "i", step: "1", type: "number"}
                  %td
                    %input{max: "255", min: "0", name: "d", step: "1", type: "number"}
                %tr.NavR
                  / 6
                  %td
                  %td
                    %input{max: "255", min: "0", name: "p", step: "1", type: "number"}
                  %td
                    %input{max: "255", min: "0", name: "i", step: "1", type: "number"}
                  %td
                    %input{max: "255", min: "0", name: "d", step: "1", type: "number"}
            #pid_accel.pid_optional.needed_by_LEVEL.gui_box.grey.topspacer.pid_tuning
              %table#pid_level.pid_tuning.needed_by_LEVEL
                %tr.needed_by_LEVEL
                  %th{colspan: "3"}
                    .pid_mode
                      %div{i18n: "pidTuningLevel", style: "float:left;"}
                      .helpicon.cf_tip{i18n_title: "pidTuningLevelHelp"}
              %table.pid_titlebar.needed_by_LEVEL
                %tr.needed_by_LEVEL
                  %th.third
                  %th.third{i18n: "pidTuningStrength", style: "width: 33%;"}
                  %th.third{i18n: "pidTuningTransition", style: "width: 33%;"}
              %table.needed_by_LEVEL
                %tr.LEVEL
                  / 7
                  %td.third{i18n: "pidTuningAngle"}
                  %td.third
                    %input{max: "255", min: "0", name: "p", step: "1", type: "number"}
                  %td.third
                %tr.LEVEL
                  / 7
                  %td.third{i18n: "pidTuningHorizon"}
                  %td.third
                    %input{max: "255", min: "0", name: "i", step: "1", type: "number"}
                  %td.third
                    %input{max: "255", min: "0", name: "d", step: "1", type: "number"}
              %table.needed_by_LEVEL.pid_titlebar.pid_sensitivity
                %tr.needed_by_LEVEL
                  %th.third
                  %th.third{i18n: "pidTuningLevelAngleLimit", style: "width: 33%;"}
                  %th.third.levelSensitivityHeader{i18n: "pidTuningLevelSensitivity", style: "width: 33%;"}
              %table#pid_sensitivity.needed_by_LEVEL.pid_tuning.pid_sensitivity
                %tr.needed_by_LEVEL
                  %td.third
                  %td.third
                    %input{max: "200", min: "10", name: "angleLimit", step: "1", type: "number"}
                  %td.third
                    %input{max: "120", min: "10", name: "sensitivity", step: "1", type: "number"}
          .cf_column
            / Pid controller advanced settings
            .gui_box.grey.pidTuningFeatures.spacer_left
              %table.pid_titlebar.new_rates
                %tr
                  %th{i18n: "pidTuningNonProfilePidSettings"}
              %table.pidTuningFeatures.new_rates
                %tbody.features.pidTuning
                  / table generated here
            .gui_box.grey.pidControllerAdvancedSettings.spacer_left
              %table.pid_titlebar.new_rates
                %tr
                  %th{i18n: "pidTuningPidSettings"}
              %table.compensation
                %tr.delta
                  %td
                    %select#delta-select
                      %option{i18n: "pidTuningDeltaError", value: "0"}
                      %option{i18n: "pidTuningDeltaMeasurement", value: "1"}
                  %td
                    %div
                      %label{for: "delta-select"}
                        %span{i18n: "pidTuningDelta"}
                      .helpicon.cf_tip{i18n_title: "pidTuningDeltaTip"}
                %tr.dtermSetpoint
                  %td
                    %input{max: "20", min: "0.00", name: "dtermSetpoint-number", step: "0.01", type: "number"}
                  %td
                    %div
                      %label
                        %span{i18n: "pidTuningDtermSetpoint"}
                      .helpicon.cf_tip{i18n_title: "pidTuningDtermSetpointHelp"}
                %tr.dtermSetpointTransition
                  %td
                    %input{max: "1.00", min: "0.01", name: "dtermSetpointTransition-number", step: "0.01", type: "number"}
                  %td{colspan: "1"}
                    %div
                      %label
                        %span{i18n: "pidTuningDtermSetpointTransition"}
                      .helpicon.cf_tip{i18n_title: "pidTuningDtermSetpointTransitionHelp"}
                %tr.dtermSetpointTransitionWarning
                  %td{colspan: "3"}
                    %span{i18n: "pidTuningDtermSetpointTransitionWarning"}
                %tr.flapBaseFrequency
                  %td
                    %input{max: "1000", min: "1", name: "flapBaseFrequency-number", step: "1", type: "number"}
                  %td{colspan: "1"}
                    %div
                      %label
                        %strong
                          %span{i18n: "pidTuningFlapBaseFrequency"}
                      .helpicon.cf_tip{i18n_title: "pidTuningFlapBaseFrequencyHelp"}
                %tr.flapBaseAmplitude
                  %td
                    %input{max: "100", min: "-100", name: "flapBaseAmplitude-number", step: "1", type: "number"}
                  %td{colspan: "1"}
                    %div
                      %label
                        %strong
                          %span{i18n: "pidTuningFlapBaseAmplitude"}
                      .helpicon.cf_tip{i18n_title: "pidTuningFlapBaseAmplitudeHelp"}
                %tr.feedforwardTransition
                  %td
                    %input{max: "1.00", min: "0.00", name: "feedforwardTransition-number", step: "0.01", type: "number"}
                  %td{colspan: "1"}
                    %div
                      %label
                        %span{i18n: "pidTuningFeedforwardTransition"}
                      .helpicon.cf_tip{i18n_title: "pidTuningFeedforwardTransitionHelp"}
                %tr.acroTrainerAngleLimit
                  %td
                    %input{max: "80", min: "10", name: "acroTrainerAngleLimit-number", step: "1", type: "number"}
                  %td{colspan: "1"}
                    %div
                      %label
                        %span{i18n: "pidTuningAcroTrainerAngleLimit"}
                      .helpicon.cf_tip{i18n_title: "pidTuningAcroTrainerAngleLimitHelp"}
                %tr.throttleBoost
                  %td
                    %input{max: "100", min: "0", name: "throttleBoost-number", step: "1", type: "number"}
                  %td{colspan: "1"}
                    %div
                      %label
                        %span{i18n: "pidTuningThrottleBoost"}
                      .helpicon.cf_tip{i18n_title: "pidTuningThrottleBoostHelp"}
                %tr.absoluteControlGain
                  %td
                    %input{max: "20", min: "0", name: "absoluteControlGain-number", step: "1", type: "number"}
                  %td{colspan: "1"}
                    %div
                      %label
                        %span{i18n: "pidTuningAbsoluteControlGain"}
                      .helpicon.cf_tip{i18n_title: "pidTuningAbsoluteControlGainHelp"}
                %tr.itermrotation
                  %td
                    %input#itermrotation.toggle{type: "checkbox"}
                  %td{colspan: "2"}
                    %span{i18n: "pidTuningItermRotation"}
                    .helpicon.cf_tip{i18n_title: "pidTuningItermRotationHelp"}
                %tr
                  %td
                    %input#vbatpidcompensation.toggle{type: "checkbox"}
                  %td{colspan: "2"}
                    %span{i18n: "pidTuningVbatPidCompensation"}
                    .helpicon.cf_tip{i18n_title: "pidTuningVbatPidCompensationHelp"}
                %tr.smartfeedforward
                  %td
                    %input#smartfeedforward.toggle{type: "checkbox"}
                  %td{colspan: "2"}
                    %span{i18n: "pidTuningSmartFeedforward"}
                    .helpicon.cf_tip{i18n_title: "pidTuningSmartFeedforwardHelp"}
                %tr.integratedYaw
                  %td
                    %input#useIntegratedYaw.toggle{type: "checkbox"}
                  %td{colspan: "2"}
                    .helpicon.cf_tip{i18n_title: "pidTuningIntegratedYawHelp"}
                    %span{i18n: "pidTuningIntegratedYaw"}
                      %span#pidTuningIntegratedYawCaution.spacer_left{i18n: "pidTuningIntegratedYawCaution"}
                %tr.itermrelax
                  %td
                    %input#itermrelax.toggle{type: "checkbox"}
                  %td{colspan: "2"}
                    .helpicon.cf_tip{i18n_title: "pidTuningItermRelaxHelp"}
                    %span{i18n: "pidTuningItermRelax"}
                      %span.suboption
                        %select#itermrelaxAxes
                          %option{i18n: "pidTuningItermRelaxAxesOptionRP", value: "1"}
                          %option{i18n: "pidTuningItermRelaxAxesOptionRPY", value: "2"}
                          %option{i18n: "pidTuningItermRelaxAxesOptionRPInc", value: "3"}
                          %option{i18n: "pidTuningItermRelaxAxesOptionRPYInc", value: "4"}
                        %label{for: "itermrelaxAxes"}
                          %span{i18n: "pidTuningItermRelaxAxes"}
                      %span.suboption
                        %select#itermrelaxType
                          %option{i18n: "pidTuningItermRelaxTypeOptionGyro", value: "0"}
                          %option{i18n: "pidTuningItermRelaxTypeOptionSetpoint", value: "1"}
                        %label{for: "itermrelaxType"}
                          %span{i18n: "pidTuningItermRelaxType"}
                      %span.itermRelaxCutoff.suboption
                        %input{max: "100", min: "1", name: "itermRelaxCutoff", step: "1", type: "number"}
                        %label{for: "itermRelaxCutoff"}
                          %span{i18n: "pidTuningItermRelaxCutoff"}
                %tr.dminGroup
                  %td
                    %input#dMinSwitch.toggle{type: "checkbox"}
                  %td{colspan: "3"}
                    .helpicon.cf_tip{i18n_title: "pidTuningDMinFeatureHelp"}
                    %span{i18n: "pidTuningDMin"}
                      %span.suboption
                        %input{max: "100", min: "0", name: "dMinGain", step: "1", type: "number"}
                        %label{for: "dMinGain"}
                          %span{i18n: "pidTuningDMinGain"}
                      %span.suboption
                        %input{max: "200", min: "0", name: "dMinAdvance", step: "1", type: "number"}
                        %label{for: "dMinAdvance"}
                          %span{i18n: "pidTuningDMinAdvance"}
                %tr.antigravity
                  %td
                    %input#antiGravitySwitch.toggle{type: "checkbox"}
                  %td{colspan: "3"}
                    .helpicon.cf_tip{i18n_title: "pidTuningAntiGravityHelp"}
                    %span{i18n: "pidTuningAntiGravity"}
                      %span.suboption.antiGravityMode
                        %select#antiGravityMode
                          %option{i18n: "pidTuningAntiGravityModeOptionSmooth", value: "0"}
                          %option{i18n: "pidTuningAntiGravityModeOptionStep", value: "1"}
                        %label{for: "antiGravityMode"}
                          %span{i18n: "pidTuningAntiGravityMode"}
                      %span.suboption
                        %input{max: "30", min: "1.1", name: "itermAcceleratorGain", step: "0.1", type: "number"}
                        %label{for: "antiGravityGain"}
                          %span{i18n: "pidTuningAntiGravityGain"}
                      %span.suboption.antiGravityThres
                        %input{max: "1000", min: "20", name: "itermThrottleThreshold", step: "10", type: "number"}
                        %label{for: "antiGravityThres"}
                          %span{i18n: "pidTuningAntiGravityThres"}
        / RATES SUBTAB
        .subtab-rates{style: "display: none;"}
          .clear-both
          .cf_column
            .gui_box.grey.rateSetup
              %table#rateSetup.pid_tuning
                %tr.pid_titlebar
                  %th.name
                  %th.rc_rate{i18n: "pidTuningRcRate"}
                  %th.rate{i18n: "pidTuningRate"}
                  %th.rc_expo{i18n: "pidTuningRcExpo"}
                  %th.new_rates.maxVel{i18n: "pidTuningMaxVel"}
                %tr.pid_titlebar2
                  %th{colspan: "5"}
                    .pid_mode
                      %div{i18n: "pidTuningRateSetup", style: "float:left;"}
                      .helpicon.cf_tip{i18n_title: "pidTuningRatesTuningHelp"}
                %tr.ROLL
                  %td.pid_roll
                  %td.rc_rate
                    %input{max: "2.55", min: "0.01", name: "rc_rate", step: "0.01", type: "number"}
                  %td.roll_rate
                    %input{max: "1.00", min: "0", name: "roll_rate", step: "0.01", type: "number"}
                  %td.roll_pitch_rate{rowspan: "2"}
                    %input{max: "1.00", min: "0", name: "roll_pitch_rate", step: "0.01", type: "number"}
                  %td.inputBackground{rowspan: "2"}
                    %input{max: "1", min: "0", name: "rc_expo", step: "0.01", type: "number"}
                    .bracket
                  %td.new_rates.maxAngularVelRoll
                %tr.PITCH
                  %td.pid_pitch
                  %td
                    %input{max: "2.55", min: "0.01", name: "rc_rate_pitch", step: "0.01", type: "number"}
                  %td.pitch_rate
                    %input{max: "1.00", min: "0", name: "pitch_rate", step: "0.01", type: "number"}
                  %td
                    %input{max: "1", min: "0", name: "rc_pitch_expo", step: "0.01", type: "number"}
                  %td.new_rates.maxAngularVelPitch
                %tr.YAW
                  %td.pid_yaw
                  %td{rowspan: "1"}
                    %input{max: "2.55", min: "0.01", name: "rc_rate_yaw", step: "0.01", type: "number"}
                  %td
                    %input{max: "2.55", min: "0", name: "yaw_rate", step: "0.01", type: "number"}
                  %td
                    %input{max: "1", min: "0", name: "rc_yaw_expo", step: "0.01", type: "number"}
                  %td.new_rates.maxAngularVelYaw
            .gui_box.rc_curve
              .rc_curve_bg
                %table.cf.rc_curve
                  %thead
