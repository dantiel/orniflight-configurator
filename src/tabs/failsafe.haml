.tab-failsafe.toolbar_fixed_bottom
  .content_wrapper
    .tab_title{i18n: "tabFailsafe"}
    .cf_doc_version_bt
      %a#button-documentation{href: "https://github.com/dantiel/orniflight/releases", rel: "noopener noreferrer", target: "_blank"}
    .note
      %p{i18n: "failsafeFeaturesHelpNew"}
    .leftWrapper
      .gui_box.grey
        .gui_box_titlebar
          .spacer_box_title{i18n: "failsafePulsrangeTitle"}
          .helpicon.cf_tip{i18n_title: "failsafePulsrangeHelp"}
        .spacer_box
          .number
            %label
              %input{max: "2250", min: "750", name: "rx_min_usec", type: "number"}
              %span{i18n: "failsafeRxMinUsecItem"}
          .number
            %label
              %input{max: "2250", min: "750", name: "rx_max_usec", type: "number"}
              %span{i18n: "failsafeRxMaxUsecItem"}
      .gui_box.grey.stage1
        .gui_box_titlebar
          .spacer_box_title{i18n: "failsafeChannelFallbackSettingsTitle"}
          .helpicon.cf_tip{i18n_title: "failsafeChannelFallbackSettingsHelp"}
        .spacer_box
          .activechannellist
            / list generated here
    .rightWrapper
      .gui_box.grey.failsafe_switch
        .gui_box_titlebar
          .spacer_box_title{i18n: "failsafeSwitchTitle"}
        .spacer_box
          .selectSwitchMode
            %label
              %select.switchMode{name: "failsafe_switch_mode"}
                %option{i18n: "failsafeSwitchOptionStage1", value: "0"}
                %option{i18n: "failsafeSwitchOptionStage2", value: "2"}
                %option{i18n: "failsafeSwitchOptionKill", value: "1"}
              %span{i18n: "failsafeSwitchModeItem"}
              .helpicon.cf_tip{i18n_title: "failsafeSwitchModeHelp"}
      .gui_box.grey
        .gui_box_titlebar
          .spacer_box_title{i18n: "failsafeStageTwoSettingsTitle"}
        .spacer_box
          %table
            %tbody.featuresNew.rxFailsafe
              / table generated here
          .checkbox.stage2.kill_switch
            .numberspacer
              %input#failsafe_kill_switch.toggle{name: "failsafe_kill_switch", type: "checkbox"}
            %label{for: "failsafe_kill_switch"}
              %span{i18n: "failsafeKillSwitchItem"}
            .helpicon.cf_tip{i18n_title: "failsafeKillSwitchHelp"}
          .number.stage2
            %label
              %input{max: "200", min: "0", name: "failsafe_delay", type: "number"}
              %span{i18n: "failsafeDelayItem"}
            .helpicon.cf_tip{i18n_title: "failsafeDelayHelp"}
          .number.stage2
            %label
              %input{max: "300", min: "0", name: "failsafe_throttle_low_delay", type: "number"}
              %span{i18n: "failsafeThrottleLowItem"}
            .helpicon.cf_tip{i18n_title: "failsafeThrottleLowHelp"}
          / radio buttons
          .subline.stage2{i18n: "failsafeSubTitle1"}
          .radioarea.pro1.stage2
            .radiobuttons
              %input#drop.procedure{name: "group1", type: "radio"}
              %label{for: "drop", i18n: "failsafeProcedureItemSelect2"}
          .radioarea.pro2.stage2
            .radiobuttons
              %input#land.procedure{checked: "", name: "group1", type: "radio"}
              %label{for: "land", i18n: "failsafeProcedureItemSelect1"}
            .proceduresettings
              .number
                %label
                  %input{max: "2000", min: "0", name: "failsafe_throttle", type: "number"}
                  %span{i18n: "failsafeThrottleItem"}
              .number
                %label
                  %input{max: "200", min: "0", name: "failsafe_off_delay", type: "number"}
                  %span{i18n: "failsafeOffDelayItem"}
                .helpicon.cf_tip{i18n_title: "failsafeOffDelayHelp"}
          .radioarea.pro4.stage2
            .radiobuttons
              %input#gps_rescue.procedure{checked: "", name: "group1", type: "radio"}
              %label{for: "gps_rescue", i18n: "failsafeProcedureItemSelect4"}
            .proceduresettings
              .number
                %label
                  %input{max: "200", min: "0", name: "gps_rescue_angle", type: "number"}
                  %span{i18n: "failsafeGpsRescueItemAngle"}
              .number
                %label
                  %input{max: "100", min: "20", name: "gps_rescue_initial_altitude", type: "number"}
                  %span{i18n: "failsafeGpsRescueItemInitialAltitude"}
              .number
                %label
                  %input{max: "500", min: "30", name: "gps_rescue_descent_distance", type: "number"}
                  %span{i18n: "failsafeGpsRescueItemDescentDistance"}
              .number
                %label
                  %input{max: "30.00", min: "0.30", name: "gps_rescue_ground_speed", step: "0.01", type: "number"}
                  %span{i18n: "failsafeGpsRescueItemGroundSpeed"}
              .number
                %label
                  %input{max: "2000", min: "1000", name: "gps_rescue_throttle_min", type: "number"}
                  %span{i18n: "failsafeGpsRescueItemThrottleMin"}
              .number
                %label
                  %input{max: "2000", min: "1000", name: "gps_rescue_throttle_max", type: "number"}
                  %span{i18n: "failsafeGpsRescueItemThrottleMax"}
              .number
                %label
                  %input{max: "2000", min: "1000", name: "gps_rescue_throttle_hover", type: "number"}
                  %span{i18n: "failsafeGpsRescueItemThrottleHover"}
              .number
                %label
                  %input{max: "50", min: "5", name: "gps_rescue_min_sats", type: "number"}
                  %span{i18n: "failsafeGpsRescueItemMinSats"}
              .selectSwitchMode
                %label
                  %select.switchMode{name: "gps_rescue_sanity_checks"}
                    %option{i18n: "failsafeGpsRescueItemSanityChecksOff", value: "0"}
                    %option{i18n: "failsafeGpsRescueItemSanityChecksOn", value: "1"}
                    %option{i18n: "failsafeGpsRescueItemSanityChecksFSOnly", value: "2"}
                  %span{i18n: "failsafeGpsRescueItemSanityChecks"}
  .content_toolbar
    .btn.save_btn
      %a.save{href: "#", i18n: "configurationButtonSave"}
