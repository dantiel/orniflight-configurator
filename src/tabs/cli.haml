.tab-cli
  .content_wrapper
    .note
      %p{i18n: "cliInfo"}
    .backdrop
      .window
        .wrapper
    %textarea{cols: "0", i18n_placeholder: "cliInputPlaceholder", name: "commands", rows: "1"}
  .content_toolbar
    .btn.save_btn.pull-right
      %a.save{href: "#", i18n: "cliSaveToFileBtn"}
      %a.load{href: "#", i18n: "cliLoadFromFileBtn"}
      %a.clear{href: "#", i18n: "cliClearOutputHistoryBtn"}
      %a.copy{href: "#", i18n: "cliCopyToClipboardBtn"}
  / Snippet preview dialog
  #snippetpreviewcontent{style: "display: none"}
    .note
      %p{i18n: "cliConfirmSnippetNote"}
    %textarea#preview{cols: "120", rows: "20"}
    .default_btn
      %a.confirm{href: "#", i18n: "cliConfirmSnippetBtn"}
